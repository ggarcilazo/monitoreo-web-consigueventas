# Plantilla de variables de entorno del backend.
# Copia este archivo como `.env` y completa los valores. El archivo `.env` NO se sube a GitHub.

# Conexión a PostgreSQL (Supabase). Si la contraseña tiene caracteres especiales, codifícalos (%26, %23, etc.)
DATABASE_URL=

# Alertas por Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PageSpeed Insights (reservado para una función futura)
PAGESPEED_API_KEY=

# Autenticación (proyecto de Supabase donde están los usuarios). La clave es la publicable (sb_publishable_...).
SUPABASE_URL=
SUPABASE_KEY=

# Clave que usa GitHub Actions para disparar el chequeo masivo (genera una con: openssl rand -hex 32)
CRON_SECRET=

# Diagnóstico público: on (encendido) u off (apagado)
AUDITORIA_PUBLICA=off

# Clave secreta de Cloudflare Turnstile (la clave del sitio va en frontend/index.html)
TURNSTILE_SECRET=
